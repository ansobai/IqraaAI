# Keep this file small and focused for local development.
# For full options, see `api/.env.example`.

# Postgres connection string (optional for tasmee; required for profile API)
DATABASE_URL=postgresql://pgadminuser:Mydatabasepassword12@iqraaai-pg55573.postgres.database.azure.com:5432/iqraaai?sslmode=require

# Clerk JWT verification (required when TASMEE_REQUIRE_AUTH=true)
CLERK_ISSUER=https://evolving-meerkat-6.clerk.accounts.dev
CLERK_AUDIENCE=

# CORS (shared by API + tasmee unless you set TASMEE_CORS_ORIGINS separately)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Tasmee core config (whisper.cpp remote STT)
TASMEE_RECOGNIZER_MODE=remote
TASMEE_REQUIRE_AUTH=true

# Tasmee -> remote STT wiring
TASMEE_REMOTE_STT_URL=http://127.0.0.1:8010/score
TASMEE_REMOTE_STT_BEARER_TOKEN=
TASMEE_REMOTE_LANGUAGE_CODES=ar
TASMEE_REMOTE_TIMEOUT_SECONDS=2

# Whisper.cpp STT service (local)
STT_WCPP_MODEL_PATH=C:\Users\Anas\Desktop\code\IqraaAI\model-convert\out\ggml-model.bin
STT_WCPP_BIN=C:\Users\Anas\Desktop\code\IqraaAI\whisper.cpp\build\bin\Release\whisper-cli.exe
STT_WCPP_LANGUAGE=ar
STT_WCPP_TASK=transcribe
STT_AUTH_TOKEN=

CLERK_AUDIENCE=

# CORS (shared by API + tasmee unless you set TASMEE_CORS_ORIGINS separately)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Tasmee core config
TASMEE_RECOGNIZER_MODE=heuristic
TASMEE_REQUIRE_AUTH=true


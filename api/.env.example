# Postgres connection string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Clerk JWT verification
# Must match the `iss` claim in the JWT.
CLERK_ISSUER=https://your-clerk-domain

# Optional: validate `aud` claim if you set it.
CLERK_AUDIENCE=

# Comma-separated list. Use * for all origins in local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

PORT=8000

# Tasmee recognizer mode: heuristic | google | remote | remote_ws | openai
TASMEE_RECOGNIZER_MODE=heuristic

# Emit extra debug payloads in websocket events (adds `debug` to session.status/feedback.delta).
TASMEE_DEBUG_EVENTS=false
TASMEE_WS_AUDIO_UPLOAD_ENABLED=true

# Auth / session security
TASMEE_REQUIRE_AUTH=true
TASMEE_WS_TOKEN_TTL_SECONDS=900

# Speech gate policy: auto | strict_meter | client_hint | stt_output
# - auto: heuristic requires meter+hint; alignment modes accept hint OR meter OR STT output.
# - strict_meter: only level_db threshold opens the gate.
# - client_hint: only has_speech opens the gate.
# - stt_output: only non-empty STT output opens the gate (alignment modes).
TASMEE_SPEECH_GATE_MODE=auto

# Optional shadow recognizer logging (runs google recognizer without affecting progress)
TASMEE_RECOGNIZER_SHADOW=false

# Google STT v2 settings (required when TASMEE_RECOGNIZER_MODE=google)
TASMEE_GOOGLE_RECOGNIZER=
TASMEE_GOOGLE_LANGUAGE_CODES=ar
TASMEE_GOOGLE_MODEL=chirp_2

# Remote STT settings (required when TASMEE_RECOGNIZER_MODE=remote or remote_ws)
# Endpoint accepts raw audio bytes and returns JSON with `tokens` or `transcript`.
TASMEE_REMOTE_STT_URL=

# Optional WS endpoint for future low-latency STT streaming (used by TASMEE_RECOGNIZER_MODE=remote_ws).
TASMEE_REMOTE_STT_WS_URL=
TASMEE_REMOTE_STT_PROTOCOL_VERSION=1

TASMEE_REMOTE_STT_BEARER_TOKEN=
TASMEE_REMOTE_LANGUAGE_CODES=ar
TASMEE_REMOTE_MODEL=
TASMEE_REMOTE_TIMEOUT_SECONDS=2

# OpenAI STT settings (required when TASMEE_RECOGNIZER_MODE=openai)
# Uses OpenAI /v1/audio/transcriptions (multipart) and expects JSON with `text`.
# Prefer setting OPENAI_API_KEY directly; TASMEE_OPENAI_API_KEY is also supported.
OPENAI_API_KEY=
TASMEE_OPENAI_API_KEY=
TASMEE_OPENAI_BASE_URL=https://api.openai.com/v1
TASMEE_OPENAI_MODEL=whisper-1
TASMEE_OPENAI_LANGUAGE=ar
TASMEE_OPENAI_PROMPT=
TASMEE_OPENAI_TIMEOUT_SECONDS=15

# Upload protection / resilience
TASMEE_MAX_CHUNK_BYTES=2000000
TASMEE_RATE_LIMIT_CHUNKS_PER_SECOND=8
TASMEE_RATE_LIMIT_BURST=20
TASMEE_PRUNE_INTERVAL_SECONDS=60

# Tasmee gating / silence behavior
TASMEE_HARD_SPEECH_LEVEL_DB_THRESHOLD=-35
TASMEE_PAUSE_SILENCE_SECONDS=10
TASMEE_ANCHOR_MIN_WORDS=2

# Tasmee verse matching (ASR/token mode)
TASMEE_VERSE_MATCH_THRESHOLD=0.9
TASMEE_MATCH_SLACK=2
# Should stay >= max words on a page to avoid truncating recited token history.
TASMEE_MAX_TOKEN_BUFFER=256
TASMEE_MAX_ANCHOR_TOKENS=16

# Optional fuzzy token overlap when merging partial STT results (0 disables).
TASMEE_FUZZY_OVERLAP_MAX_DISTANCE=0

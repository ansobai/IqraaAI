# Postgres connection string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Clerk JWT verification
# Must match the `iss` claim in the JWT.
CLERK_ISSUER=https://your-clerk-domain

# Optional: validate `aud` claim if you set it.
CLERK_AUDIENCE=

# Comma-separated list. Use * for all origins in local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

PORT=8000

# Tasmee recognizer mode: heuristic | google | remote
TASMEE_RECOGNIZER_MODE=heuristic

# Optional shadow recognizer logging (runs google recognizer without affecting progress)
TASMEE_RECOGNIZER_SHADOW=false

# Google STT v2 settings (required when TASMEE_RECOGNIZER_MODE=google)
TASMEE_GOOGLE_RECOGNIZER=
TASMEE_GOOGLE_LANGUAGE_CODES=ar
TASMEE_GOOGLE_MODEL=chirp_2

# Remote STT settings (required when TASMEE_RECOGNIZER_MODE=remote)
# Endpoint accepts raw audio bytes and returns JSON with `tokens` or `transcript`.
TASMEE_REMOTE_STT_URL=
TASMEE_REMOTE_STT_BEARER_TOKEN=
TASMEE_REMOTE_LANGUAGE_CODES=ar
TASMEE_REMOTE_MODEL=
TASMEE_REMOTE_TIMEOUT_SECONDS=2

# Tasmee gating / silence behavior
TASMEE_HARD_SPEECH_LEVEL_DB_THRESHOLD=-35
TASMEE_PAUSE_SILENCE_SECONDS=10
TASMEE_ANCHOR_MIN_WORDS=2

# Tasmee verse matching (ASR/token mode)
TASMEE_VERSE_MATCH_THRESHOLD=0.9
TASMEE_MATCH_SLACK=2
# Should stay >= max words on a page to avoid truncating recited token history.
TASMEE_MAX_TOKEN_BUFFER=256
TASMEE_MAX_ANCHOR_TOKENS=16

# Postgres connection string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Clerk JWT verification
# Must match the `iss` claim in the JWT.
CLERK_ISSUER=https://your-clerk-domain

# Optional: validate `aud` claim if you set it.
CLERK_AUDIENCE=

# Comma-separated list. Use * for all origins in local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

PORT=8000

# Tasmee recognizer mode: heuristic | google | remote | remote_ws | openai
TASMEE_RECOGNIZER_MODE=remote

# Emit extra debug payloads in websocket events (adds `debug` to session.status/feedback.delta).
TASMEE_DEBUG_EVENTS=false
TASMEE_WS_AUDIO_UPLOAD_ENABLED=true

# Auth / session security
TASMEE_REQUIRE_AUTH=true
TASMEE_WS_TOKEN_TTL_SECONDS=900

# Speech gate policy: auto | strict_meter | client_hint | stt_output
# - auto: heuristic requires meter+hint; alignment modes accept hint OR meter OR STT output.
# - strict_meter: only level_db threshold opens the gate.
# - client_hint: only has_speech opens the gate.
# - stt_output: only non-empty STT output opens the gate (alignment modes).
TASMEE_SPEECH_GATE_MODE=auto

# Remote STT settings (required when TASMEE_RECOGNIZER_MODE=remote)
# Endpoint accepts raw audio bytes and returns JSON with `tokens` or `transcript`.
TASMEE_REMOTE_STT_URL=

# Optional WS endpoint for low-latency STT streaming (used by TASMEE_RECOGNIZER_MODE=remote_ws).
TASMEE_REMOTE_STT_WS_URL=
TASMEE_REMOTE_STT_PROTOCOL_VERSION=2
TASMEE_REMOTE_STT_FRAME_MS=30
TASMEE_REMOTE_STT_SAMPLE_RATE_HZ=16000
TASMEE_REMOTE_STT_STREAM_REALTIME=false
TASMEE_REMOTE_STT_FINAL_WAIT_SECONDS=2
TASMEE_REMOTE_STT_RETURN_PARTIAL_ON_TIMEOUT=true
TASMEE_REMOTE_STT_BEARER_TOKEN=
TASMEE_REMOTE_LANGUAGE_CODES=ar
TASMEE_REMOTE_MODEL=
TASMEE_REMOTE_TIMEOUT_SECONDS=2
# Phase 6 reliability guardrails (tasmee recognizer path)
TASMEE_MAX_ACTIVE_SESSIONS=5000
TASMEE_RECOGNIZER_MAX_INFLIGHT=8
TASMEE_RECOGNIZER_QUEUE_TIMEOUT_SECONDS=0.25
TASMEE_RECOGNIZER_HARD_TIMEOUT_SECONDS=3
TASMEE_DEGRADE_ON_RECOGNIZER_STALL=true
# Optional ffmpeg binary path for remote_ws local audio decode.
TASMEE_FFMPEG_BIN=ffmpeg
# Optional Phase 1 region alignment guard (Azure ML URL parsing):
TASMEE_EXPECTED_STT_REGION=
TASMEE_STRICT_STT_REGION_CHECK=false

# Optional: env for the separate whisper.cpp STT service (`api/stt_service_whisper_cpp`).
# Only needed if you run that service from the same env file.
STT_AUTH_TOKEN=
STT_WCPP_MODEL_PATH=
STT_WCPP_BIN=whisper-cli
STT_WCPP_LANGUAGE=ar
STT_WCPP_TASK=transcribe
STT_WCPP_THREADS=
STT_WCPP_TIMEOUT_SECONDS=120
STT_WCPP_RETURN_TOKENS=false
STT_WCPP_EXTRA_ARGS=

# Upload protection / resilience
TASMEE_MAX_CHUNK_BYTES=2000000
TASMEE_RATE_LIMIT_CHUNKS_PER_SECOND=8
TASMEE_RATE_LIMIT_BURST=20
TASMEE_PRUNE_INTERVAL_SECONDS=60

# Tasmee gating / silence behavior
TASMEE_HARD_SPEECH_LEVEL_DB_THRESHOLD=-35
TASMEE_PAUSE_SILENCE_SECONDS=10
TASMEE_ANCHOR_MIN_WORDS=2

# Tasmee verse matching (ASR/token mode)
TASMEE_VERSE_MATCH_THRESHOLD=0.9
TASMEE_MATCH_SLACK=2
# Should stay >= max words on a page to avoid truncating recited token history.
TASMEE_MAX_TOKEN_BUFFER=256
TASMEE_MAX_ANCHOR_TOKENS=16
TASMEE_PARTIAL_PROGRESS_MIN_STABILITY=0.55
TASMEE_PARTIAL_ANCHOR_MIN_TOKENS=2
TASMEE_PARTIAL_TRACK_MIN_TOKENS=2

# Optional fuzzy token overlap when merging partial STT results (0 disables).
TASMEE_FUZZY_OVERLAP_MAX_DISTANCE=0

# STT service (api/stt_service) Phase 4 two-pass knobs.
# Configure these on the STT deployment environment, not necessarily this API service.
# STT_MODEL_ID=Systran/faster-whisper-small
# STT_FINAL_MODEL_ID=<quran-tuned-model-id>
# STT_FINAL_COMPUTE_TYPE=float16
# STT_FINAL_BEAM_SIZE=2
# STT_FINAL_BEST_OF=2
# STT_FINAL_PROMPT=
#
# Phase 6 STT load shedding / backpressure knobs:
# STT_STREAM_MAX_ACTIVE_STREAMS=64
# STT_STREAM_SLOT_WAIT_SECONDS=0.05
# STT_STREAM_DECODE_MAX_CONCURRENCY=2
# STT_STREAM_DECODE_QUEUE_TIMEOUT_SECONDS=0.25
# STT_STREAM_PARTIAL_DECODE_TIMEOUT_SECONDS=1.2
# STT_STREAM_FINAL_DECODE_TIMEOUT_SECONDS=4.0
# STT_STREAM_SKIP_PARTIAL_UNDER_BACKPRESSURE=true
# STT_GPU_METRICS_ENABLED=true
# STT_GPU_METRICS_CACHE_TTL_SECONDS=2

# Benchmarking (Phase 0 baseline harness)
# Used by: python api/scripts/run_tasmee_benchmark.py
TASMEE_BENCH_BASE_URL=http://127.0.0.1:8080
TASMEE_BENCH_BEARER_TOKEN=
TASMEE_BENCH_STT_HOURLY_USD=0
TASMEE_BENCH_TASMEE_HOURLY_USD=0
